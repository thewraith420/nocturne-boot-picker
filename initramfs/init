#!/bin/sh
# PID 1 for the picker initramfs: bring up just enough of the system to
# read /boot, discover real kernels, run the touch menu, and kexec.

mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mkdir -p /dev/pts
mount -t devpts none /dev/pts

mdev -s

mkdir -p /run/picker /mnt/root

# kexec-boot.sh correctly refuses to run with a missing linux path
# (set -eu, ${2:?}) - but since it's exec'd below in place of PID 1,
# that clean refusal becomes "Attempted to kill init!" instead of
# anything recoverable. So every stage that could leave
# SELECTED_LINUX empty needs to be caught here first, with a real
# fallback - either the first discovered kernel (same "first entry is
# the default" convention PICKER_TIMEOUT_SECS uses in ui/picker.c) or,
# if there's no discovered kernel to fall back to at all, a rescue
# shell instead of letting init exit and panic. Found and verified via
# a standalone control-flow test (not hardware-dependent - pure shell
# logic) after real-hardware code review turned up the gap.
rescue() {
    echo "picker: $1" >&2
    echo "picker: dropping to a rescue shell" >&2
    exec /bin/sh
}

# Root and /boot are the same partition on the Slate: /dev/mmcblk0p2
# (ext4, eMMC via sdhci_pci/cqhci - no NVMe/SATA/UFS). No LABEL is set,
# and busybox mdev doesn't populate /dev/disk/by-uuid without a custom
# blkid-driven rule, so this is a raw device path rather than
# by-label/by-uuid - fine here since eMMC partition numbering is stable
# (fixed internal storage, nothing to hot-plug ahead of it). Confirmed
# on real hardware; UUID=076aa633-aff9-4f0f-98a7-f939eb74e7ff or
# PARTUUID=e16d3cff-5493-4c48-b2ef-88ffc913e7a4 if by-uuid symlinks ever
# get added instead. /boot/efi is a separate vfat ESP but only holds
# GRUB's own EFI binary - grub.cfg lives on this ext4 partition, so the
# ESP is never mounted here.
: "${REAL_ROOT_DEV:=/dev/mmcblk0p2}"
if ! mount -o ro "$REAL_ROOT_DEV" /mnt/root; then
    rescue "failed to mount real root ($REAL_ROOT_DEV)"
fi

if ! /bin/discover-kernels.sh /mnt/root/boot/grub/grub.cfg > /run/picker/menu.tsv.raw || [ ! -s /run/picker/menu.tsv.raw ]; then
    rescue "no kernel entries found (discover-kernels.sh failed, or grub.cfg missing/empty)"
fi

# Moves a previously "Set Default"-marked entry to the front, if it's
# still present - see apply-default.sh. A missing/stale marker just
# passes the list through unchanged.
DEFAULT_MARKER=/mnt/root/boot/picker-default
/bin/apply-default.sh /run/picker/menu.tsv.raw "$DEFAULT_MARKER" > /run/picker/menu.tsv

# Fallback target if the picker itself fails for any reason (no touch
# device, no DRM output, crash, ...).
default_line=$(head -n1 /run/picker/menu.tsv)
default_linux=$(printf '%s' "$default_line" | cut -f2)
default_initrd=$(printf '%s' "$default_line" | cut -f3)
default_cmdline=$(printf '%s' "$default_line" | cut -f4)

if /bin/picker /run/picker/menu.tsv > /run/picker/selected; then
    # Sets SELECTED_LINUX, SELECTED_INITRD, SELECTED_CMDLINE, and
    # SET_DEFAULT=1 if "Set Default" was used.
    . /run/picker/selected
else
    echo "picker: picker exited with an error - falling back to the default entry" >&2
    SELECTED_LINUX="$default_linux"
    SELECTED_INITRD="$default_initrd"
    SELECTED_CMDLINE="$default_cmdline"
fi

if [ -z "$SELECTED_LINUX" ]; then
    echo "picker: picker produced no selection - falling back to the default entry" >&2
    SELECTED_LINUX="$default_linux"
    SELECTED_INITRD="$default_initrd"
    SELECTED_CMDLINE="$default_cmdline"
fi

if [ -z "$SELECTED_LINUX" ]; then
    rescue "no usable kernel entry to boot"
fi

# Persisting "Set Default" means briefly remounting the real root
# read-write, which /mnt/root was deliberately mounted read-only to
# avoid needing at all (keeps the picker's normal blast radius small -
# see boot-integration/README.md). This is the one exception, and it's
# best-effort: a failure here should never block booting into what the
# user actually just chose, so every step just logs and moves on
# rather than treating persistence as required.
if [ "${SET_DEFAULT:-}" = "1" ]; then
    if mount -o remount,rw /mnt/root; then
        if ! printf '%s\n' "$SELECTED_LINUX" > "$DEFAULT_MARKER" 2>/dev/null; then
            echo "picker: failed to write default preference (continuing anyway)" >&2
        fi
        mount -o remount,ro /mnt/root || \
            echo "picker: failed to remount root read-only after saving default (continuing anyway)" >&2
    else
        echo "picker: failed to remount root read-write to save default preference (continuing anyway)" >&2
    fi
fi

exec /sbin/kexec-boot.sh /mnt/root "$SELECTED_LINUX" "$SELECTED_INITRD" "$SELECTED_CMDLINE"
