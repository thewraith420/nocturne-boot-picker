#!/bin/sh
# PID 1 for the picker initramfs: bring up just enough of the system to
# read /boot, discover real kernels, run the touch menu, and kexec.

mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mkdir -p /dev/pts
mount -t devpts none /dev/pts

mdev -s

mkdir -p /run/picker /mnt/root

# kexec-boot.sh correctly refuses to run with a missing linux path
# (set -eu, ${2:?}) - but since it's exec'd below in place of PID 1,
# that clean refusal becomes "Attempted to kill init!" instead of
# anything recoverable. So every stage that could leave
# SELECTED_LINUX empty needs to be caught here first, with a real
# fallback - either the first discovered kernel (same "first entry is
# the default" convention PICKER_TIMEOUT_SECS uses in ui/picker.c) or,
# if there's no discovered kernel to fall back to at all, a rescue
# shell instead of letting init exit and panic. Found and verified via
# a standalone control-flow test (not hardware-dependent - pure shell
# logic) after real-hardware code review turned up the gap.
# Everything this script does happens in a window with no journal, no
# scrollback and - on the fallback paths - no user-visible output at
# all. That silence is deliberate: falling back straight into a working
# kernel beats stranding someone at a prompt. But from the outside it is
# indistinguishable from "the GRUB selection never took", which is
# exactly what the first real boot attempt looked like: straight to the
# desktop, no menu, nothing left behind to say why. Losing an entire
# boot attempt to no evidence is worse than the few hundred ms this
# costs, so: record what happened somewhere that survives the kexec.
#
# Strictly best-effort. Every step can fail and the boot continues -
# diagnostics must never be the reason a machine doesn't come up.
BOOT_LOG=/mnt/root/boot/picker-last-boot.log
stages=""
stage() {
    stages="${stages}  - $1
"
    echo "picker: $1" >&2
}

# Every hardware test so far ran ./picker by hand on a fully booted
# system, where the eMMC, i915 and the I2C-HID touch controller had
# finished probing minutes earlier. As PID 1 we are in a footrace with
# them: devtmpfs creates each node when its driver binds, and init
# reaches picker within milliseconds of the kernel handing over. picker
# exits non-zero if /dev/dri has no card (picker.c:748) or if no touch
# device is found (picker.c:754) - and init's fallback then boots the
# default silently, which is precisely the "nothing happened" the first
# real attempt produced. A device that shows up 200ms later looks
# identical to one that is missing entirely, so wait for it rather than
# sampling once.
#
# $1 = description, $2 = path or glob, $3 = seconds to wait.
# Never fatal: on timeout we carry on and let the normal failure path
# report it, since a wrong guess here should not strand anyone.
have_any() {
    for _f in $1; do [ -e "$_f" ] && return 0; done
    return 1
}
wait_for() {
    _n=0
    have_any "$2" && return 0
    stage "waiting for $1 ($2)"
    while [ "$_n" -lt "$3" ]; do
        sleep 1
        _n=$((_n + 1))
        if have_any "$2"; then
            stage "$1 appeared after ${_n}s"
            return 0
        fi
    done
    stage "TIMEOUT: $1 ($2) never appeared after ${3}s"
    return 1
}

# $1 = outcome summary. Writes the log to the real root, which is
# mounted read-only, so this borrows the same brief remount dance
# apply-default uses (see below) - and puts it back read-only after.
save_log() {
    [ -d /mnt/root/boot ] || {
        echo "picker: (real root not mounted - cannot save a boot log)" >&2
        return 0
    }
    mount -o remount,rw /mnt/root 2>/dev/null || {
        echo "picker: (could not remount rw - cannot save a boot log)" >&2
        return 0
    }
    {
        echo "=== nocturne picker boot log ==="
        echo "outcome:  $1"
        echo "when:     $(date 2>/dev/null || echo '(no clock)')"
        echo "kernel:   $(uname -r 2>/dev/null)"
        echo
        echo "--- stages reached ---"
        printf '%s' "$stages"
        echo
        echo "--- selection ---"
        echo "linux=${SELECTED_LINUX:-}"
        echo "initrd=${SELECTED_INITRD:-}"
        echo "cmdline=${SELECTED_CMDLINE:-}"
        echo
        # If picker never drew anything, the reason is usually that one
        # of these is simply absent - which is instant to see here and
        # near-impossible to guess at from a blank screen.
        echo "--- /dev/dri (DRM - picker cannot draw without this) ---"
        ls -l /dev/dri 2>&1 || true
        echo
        echo "--- /dev/input (touch) ---"
        ls -l /dev/input 2>&1 || true
        echo
        echo "--- picker exit code: ${picker_rc:-n/a} ---"
        echo "--- picker stderr ---"
        cat /run/picker/picker.stderr 2>/dev/null || echo "(none captured)"
        echo
        echo "--- menu.tsv (first 5 of $(cat /run/picker/menu.tsv 2>/dev/null | wc -l 2>/dev/null) entries) ---"
        head -n5 /run/picker/menu.tsv 2>/dev/null || echo "(no menu)"
        echo
        echo "--- dmesg (last 150 lines) ---"
        dmesg 2>/dev/null | tail -n150 || echo "(dmesg unavailable)"
    } > "$BOOT_LOG" 2>/dev/null || \
        echo "picker: (failed to write $BOOT_LOG)" >&2
    # Flush before kexec: the new kernel does not replay this page cache.
    sync 2>/dev/null || true
    mount -o remount,ro /mnt/root 2>/dev/null || true
    return 0
}

rescue() {
    save_log "rescue: $1"
    echo "picker: $1" >&2
    echo "picker: dropping to a rescue shell" >&2
    exec /bin/sh
}

# Root and /boot are the same partition on the Slate: /dev/mmcblk0p2
# (ext4, eMMC via sdhci_pci/cqhci - no NVMe/SATA/UFS). No LABEL is set,
# and busybox mdev doesn't populate /dev/disk/by-uuid without a custom
# blkid-driven rule, so this is a raw device path rather than
# by-label/by-uuid - fine here since eMMC partition numbering is stable
# (fixed internal storage, nothing to hot-plug ahead of it). Confirmed
# on real hardware; UUID=076aa633-aff9-4f0f-98a7-f939eb74e7ff or
# PARTUUID=e16d3cff-5493-4c48-b2ef-88ffc913e7a4 if by-uuid symlinks ever
# get added instead. /boot/efi is a separate vfat ESP but only holds
# GRUB's own EFI binary - grub.cfg lives on this ext4 partition, so the
# ESP is never mounted here.
: "${REAL_ROOT_DEV:=/dev/mmcblk0p2}"
# eMMC probe is not instant, and a root mount that fails here drops
# straight to the rescue shell - the harshest outcome in the script.
wait_for "root device" "$REAL_ROOT_DEV" "${PICKER_WAIT_ROOT:-15}"
stage "mounting real root ($REAL_ROOT_DEV)"
if ! mount -o ro "$REAL_ROOT_DEV" /mnt/root; then
    rescue "failed to mount real root ($REAL_ROOT_DEV)"
fi

stage "discovering kernels from grub.cfg"
if ! /bin/discover-kernels.sh /mnt/root/boot/grub/grub.cfg > /run/picker/menu.tsv.raw || [ ! -s /run/picker/menu.tsv.raw ]; then
    rescue "no kernel entries found (discover-kernels.sh failed, or grub.cfg missing/empty)"
fi

# Moves a previously "Set Default"-marked entry to the front, if it's
# still present - see apply-default.sh. A missing/stale marker just
# passes the list through unchanged.
DEFAULT_MARKER=/mnt/root/boot/picker-default
/bin/apply-default.sh /run/picker/menu.tsv.raw "$DEFAULT_MARKER" > /run/picker/menu.tsv

# Fallback target if the picker itself fails for any reason (no touch
# device, no DRM output, crash, ...).
default_line=$(head -n1 /run/picker/menu.tsv)
default_linux=$(printf '%s' "$default_line" | cut -f2)
default_initrd=$(printf '%s' "$default_line" | cut -f3)
default_cmdline=$(printf '%s' "$default_line" | cut -f4)

# The Slate's panel is mounted rotated: 270 is upright, confirmed on
# real hardware. ui/picker.c defaults to 0 when this is unset, which is
# correct as a library default but wrong for the only machine this
# initramfs is ever built for - so set it here rather than leaving the
# first boot to come up sideways. Same transform drives touch, so an
# unset value is cosmetic (taps still land on the buttons you see)
# rather than broken - which is exactly why it could go unnoticed.
: "${PICKER_ROTATE:=270}"
export PICKER_ROTATE

# stderr goes to a file rather than the console: it carries picker's own
# diagnostics (chosen touch device, DRM open failures) plus LVGL's log,
# which is the single most useful thing to have when picker fails, and
# on the console it scrolls past behind the kexec faster than anyone can
# read it. It gets replayed to the screen on the failure path below, and
# copied into the boot log either way.
# Both of these are hard requirements for picker: it returns non-zero
# rather than degrading if either is absent.
wait_for "DRM device (i915)" "/dev/dri/card*" "${PICKER_WAIT_DRM:-15}"
wait_for "touch input device" "/dev/input/event*" "${PICKER_WAIT_INPUT:-15}"

stage "running picker"
if /bin/picker /run/picker/menu.tsv > /run/picker/selected 2>/run/picker/picker.stderr; then
    picker_rc=0
    # Sets SELECTED_LINUX, SELECTED_INITRD, SELECTED_CMDLINE, and
    # SET_DEFAULT=1 if "Set Default" was used.
    . /run/picker/selected
else
    picker_rc=$?
    picker_failed="picker exited $picker_rc"
    SELECTED_LINUX="$default_linux"
    SELECTED_INITRD="$default_initrd"
    SELECTED_CMDLINE="$default_cmdline"
fi

if [ -z "$SELECTED_LINUX" ]; then
    picker_failed="${picker_failed:-picker produced no selection}"
    SELECTED_LINUX="$default_linux"
    SELECTED_INITRD="$default_initrd"
    SELECTED_CMDLINE="$default_cmdline"
fi

# The fallback is silent by design, and that is precisely what made the
# first boot attempt undebuggable - it looks identical to GRUB ignoring
# the selection. Say so on screen, show why, and hold long enough to
# read or photograph it before the kexec wipes the display.
if [ -n "${picker_failed:-}" ]; then
    stage "FALLBACK: $picker_failed"
    echo "" >&2
    echo "picker: ================================================" >&2
    echo "picker: the menu could not be shown ($picker_failed)." >&2
    echo "picker: booting the default entry instead:" >&2
    echo "picker:   $SELECTED_LINUX" >&2
    echo "picker: last lines of picker's own output:" >&2
    # Redirection order matters: point stdout at the real stderr FIRST,
    # then silence tail's own errors. The other order aims fd1 at the
    # /dev/null that fd2 has just become, and this replay - the only
    # copy anyone without SSH will ever see - vanishes.
    tail -n15 /run/picker/picker.stderr >&2 2>/dev/null || echo "picker:   (none)" >&2
    echo "picker: full details saved to /boot/picker-last-boot.log" >&2
    echo "picker: ================================================" >&2
    sleep "${PICKER_FALLBACK_PAUSE:-8}"
fi

if [ -z "$SELECTED_LINUX" ]; then
    rescue "no usable kernel entry to boot"
fi

# Persisting "Set Default" means briefly remounting the real root
# read-write, which /mnt/root was deliberately mounted read-only to
# avoid needing at all (keeps the picker's normal blast radius small -
# see boot-integration/README.md). This is the one exception, and it's
# best-effort: a failure here should never block booting into what the
# user actually just chose, so every step just logs and moves on
# rather than treating persistence as required.
if [ "${SET_DEFAULT:-}" = "1" ]; then
    if mount -o remount,rw /mnt/root; then
        if ! printf '%s\n' "$SELECTED_LINUX" > "$DEFAULT_MARKER" 2>/dev/null; then
            echo "picker: failed to write default preference (continuing anyway)" >&2
        fi
        mount -o remount,ro /mnt/root || \
            echo "picker: failed to remount root read-only after saving default (continuing anyway)" >&2
    else
        echo "picker: failed to remount root read-write to save default preference (continuing anyway)" >&2
    fi
fi

if [ -n "${picker_failed:-}" ]; then
    save_log "fell back: $picker_failed"
else
    save_log "booted user selection"
fi

stage "kexec into $SELECTED_LINUX"
exec /sbin/kexec-boot.sh /mnt/root "$SELECTED_LINUX" "$SELECTED_INITRD" "$SELECTED_CMDLINE"
